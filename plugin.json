{
  "id": "phpforge.php-intelligence",
  "name": "PHP Intelligence",
  "version": "1.0.1",
  "minIdeVersion": "0.2.13",
  "main": "main.js",
  "description": "PHP semantic navigation, local types, hierarchy, inspections and refactorings.",
  "activation": {
    "languages": [
      "php"
    ]
  },
  "permissions": [
    "project.read",
    "project.write",
    "process",
    "workbench"
  ],
  "workbench": {
    "apiVersion": 1,
    "main": "workbench.js",
    "style": "workbench.css",
    "services": [
      "listFiles",
      "fileExists",
      "language",
      "languageApply"
    ]
  }
}
